ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_REVISION
ARG HELPER_SHA256
COPY --chmod=0755 labcontainers-guest /labcontainers-guest
RUN test -n "$SOURCE_REVISION" && test -n "$HELPER_SHA256" && \
    printf '%s  /labcontainers-guest\n' "$HELPER_SHA256" | sha256sum -c -
LABEL appmana.labcontainers.revision="${SOURCE_REVISION}" \
      appmana.labcontainers.guest-helper-sha256="${HELPER_SHA256}"
