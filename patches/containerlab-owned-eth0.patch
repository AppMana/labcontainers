+// A data endpoint can be named eth0 when runtime management networking is
+// disabled. Use endpoint ownership, not the conventional management name.
+func isOwnedInterfaceFor(link netlink.Link, ownerName string, knownIfaceNames map[string]struct{}) bool {
+	name := link.Attrs().Name
+	if name == "lo" {
+		return false
+	}
+	if knownIfaceNames != nil {
+		if _, known := knownIfaceNames[name]; !known {
+			return false
+		}
+	}
+	return HasOwnershipAltNameFor(link, ownerName, name)
+}
