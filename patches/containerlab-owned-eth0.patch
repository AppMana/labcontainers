diff --git a/links/ownership_test.go b/links/ownership_test.go
new file mode 100644
index 00000000..7b85b2fb
--- /dev/null
+++ b/links/ownership_test.go
@@ -0,0 +1,49 @@
+package links
+
+import (
+	"testing"
+
+	"github.com/vishvananda/netlink"
+)
+
+func TestEth0DiscoveryUsesOwnershipNotManagementName(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name, iface, owner string
+		want               bool
+	}{
+		{"owned data eth0", "eth0", "node", true},
+		{"unowned management eth0", "eth0", "", false},
+		{"foreign eth0", "eth0", "other", false},
+		{"owned ordinary data", "eth1", "node", true},
+		{"loopback remains excluded", "lo", "node", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			link := &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: tc.iface}}
+			if tc.owner != "" {
+				link.Attrs().AltNames = []string{ownershipAltNameFor(tc.owner, tc.iface)}
+			}
+			for _, known := range []map[string]struct{}{nil, {tc.iface: {}}} {
+				if got := isOwnedInterfaceFor(link, "node", known); got != tc.want {
+					t.Fatalf("discovered=%v want=%v", got, tc.want)
+				}
+			}
+			if isOwnedInterfaceFor(link, "node", map[string]struct{}{}) {
+				t.Fatal("ignored known-interface filter")
+			}
+		})
+	}
+}
+
+func TestParkingRetainsOwnedDataEth0(t *testing.T) {
+	t.Parallel()
+	link := &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: "eth0"}}
+	known := map[string]struct{}{"eth0": {}}
+	if isOwnedInterface(link, known) {
+		t.Fatal("unmarked management eth0 must not be parked")
+	}
+	link.Attrs().AltNames = []string{ownershipAltNameFor("node", "eth0")}
+	if !isOwnedInterface(link, known) {
+		t.Fatal("owned data eth0 must be parked")
+	}
+}
