@@ -0,0 +1,44 @@
+package core
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/srl-labs/containerlab/mocks/mocknodes"
+	"github.com/srl-labs/containerlab/nodes"
+	"go.uber.org/mock/gomock"
+)
+
+func TestStoppedEndpointOwnershipWithoutNamespace(t *testing.T) {
+	for _, state := range []string{"starting", "recreating"} {
+		t.Run(state, func(t *testing.T) {
+			node := mocknodes.NewMockNode(gomock.NewController(t))
+			lab := &CLab{Nodes: map[string]nodes.Node{"vm": node}}
+			plan := newApplyPlan(nil, nil)
+			plan.desiredEndpointSet[applyEndpointKey{node: "vm", iface: "eth1"}] = struct{}{}
+			if state == "starting" {
+				plan.startNodeSet["vm"] = struct{}{}
+			} else {
+				plan.recreatedNodeSet["vm"] = struct{}{}
+			}
+			// No ExecFunction expectation: there is no usable namespace.
+			if err := lab.validateDesiredEndpointOwnership(context.Background(), plan); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestStoppedEndpointStillValidatesPreservedNamespace(t *testing.T) {
+	node := mocknodes.NewMockNode(gomock.NewController(t))
+	node.EXPECT().ExecFunction(gomock.Any(), gomock.Any()).Return(errors.New("unowned interface"))
+	lab := &CLab{Nodes: map[string]nodes.Node{"vm": node}}
+	plan := newApplyPlan(nil, nil)
+	plan.startNodeSet["vm"] = struct{}{}
+	plan.desiredEndpointSet[applyEndpointKey{node: "vm", iface: "eth1"}] = struct{}{}
+	plan.setEndpointNode("vm", node)
+	if err := lab.validateDesiredEndpointOwnership(context.Background(), plan); err == nil {
+		t.Fatal("preserved namespace escaped ownership validation")
+	}
+}
